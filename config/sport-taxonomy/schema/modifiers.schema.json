{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skadia.local/schema/sport-taxonomy/modifiers.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["modifiers"],
  "properties": {
    "modifiers": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/modifier"}
    }
  },
  "$defs": {
    "localeMap": {
      "type": "object",
      "additionalProperties": {"type": "string"},
      "required": ["de"],
      "properties": {
        "de": {"type": "string", "minLength": 1}
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activity_state",
        "modifier_filter",
        "modifier_patch",
        "taxonomy_default"
      ],
      "properties": {
        "activity_state": {"type": "boolean"},
        "modifier_filter": {"type": "boolean"},
        "modifier_patch": {"type": "boolean"},
        "taxonomy_default": {"type": "boolean"}
      }
    },
    "modifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "labels",
        "go_field",
        "ts_field",
        "json_key",
        "activity_column",
        "action_name",
        "action_param",
        "shadowfs_token",
        "capabilities"
      ],
      "properties": {
        "key": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "labels": {"$ref": "#/$defs/localeMap"},
        "go_field": {"type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$"},
        "ts_field": {"type": "string", "pattern": "^[a-z][A-Za-z0-9]*$"},
        "json_key": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "activity_column": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "action_name": {"type": "string", "pattern": "^set_[a-z0-9_]+$"},
        "action_param": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "shadowfs_token": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "capabilities": {"$ref": "#/$defs/capabilities"}
      }
    }
  }
}
