{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skadia Sport Taxonomy",
  "type": "object",
  "additionalProperties": false,
  "required": ["categories", "sports"],
  "properties": {
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "labels", "color"],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "labels": { "$ref": "#/$defs/localeMap" },
          "color": {
            "type": "object",
            "additionalProperties": false,
            "required": ["token", "light_hex"],
            "properties": {
              "token": { "type": "string", "minLength": 1 },
              "light_hex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
            }
          }
        }
      }
    },
    "sports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sport_type",
          "category_key",
          "labels",
          "auto_titles",
          "segment_group",
          "typically_has_gps",
          "moving_threshold",
          "is_indoor",
          "traits",
          "modifier_applicability"
        ],
        "properties": {
          "sport_type": { "type": "string", "minLength": 1 },
          "category_key": { "type": "string", "minLength": 1 },
          "labels": { "$ref": "#/$defs/localeMap" },
          "auto_titles": { "$ref": "#/$defs/localeMap" },
          "segment_group": {
            "type": "string",
            "enum": ["bike", "foot", "swim", "ski", "paddle", "generic"]
          },
          "typically_has_gps": { "type": "boolean" },
          "moving_threshold": { "type": "number", "minimum": 0 },
          "is_indoor": { "type": "boolean" },
          "traits": { "$ref": "#/$defs/traits" },
          "lifecycle": {
            "type": "string",
            "enum": ["canonical", "broad_fallback", "deprecated"]
          },
          "selectable": { "type": "boolean" },
          "modifier_applicability": {
            "type": "object",
            "additionalProperties": false,
            "required": ["is_electric", "is_indoor", "is_virtual", "is_commute"],
            "properties": {
              "is_electric": { "type": "boolean" },
              "is_indoor": { "type": "boolean" },
              "is_virtual": { "type": "boolean" },
              "is_commute": { "type": "boolean" }
            }
          },
          "sub_types": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["sub_type", "labels", "details", "auto_titles"],
              "properties": {
                "sub_type": { "type": "string", "minLength": 1 },
                "labels": { "$ref": "#/$defs/localeMap" },
                "details": { "$ref": "#/$defs/localeMap" },
                "auto_titles": { "$ref": "#/$defs/localeMap" },
                "moving_threshold": { "type": "number", "minimum": 0 },
                "selectable": { "type": "boolean" },
                "traits": { "$ref": "#/$defs/traits" }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "localeMap": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "required": ["de"],
      "properties": {
        "de": { "type": "string", "minLength": 1 }
      }
    },
    "traits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environments",
        "movement_families",
        "equipment_families",
        "activity_form",
        "propulsion_modes"
      ],
      "properties": {
        "environments": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["land", "water", "snow", "ice", "air", "indoor", "generic"]
          }
        },
        "movement_families": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["run", "walk", "roll", "pedal", "swim", "paddle", "row", "glide", "climb", "lift", "strike", "throw", "dance", "mind_body", "combat", "ride", "drive", "fly", "multi", "fish", "generic"]
          }
        },
        "equipment_families": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["bike", "wheelchair", "skate", "ski", "snowboard", "sled", "board", "paddle", "boat", "sail", "breathing_gear", "fishing_gear", "machine", "weights", "rope", "ball", "racket", "stick", "disc", "climbing_gear", "aircraft", "animal", "vehicle", "weapon", "generic"]
          }
        },
        "activity_form": {
          "type": "string",
          "enum": ["single", "family", "composite", "transition", "mode", "fallback", "system"]
        },
        "propulsion_modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["human", "gravity", "wind", "motor", "towed", "animal", "generic"]
          }
        }
      }
    }
  }
}
