{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skadia sport source aliases",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "aliases"],
  "properties": {
    "source": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["raw", "sport_type"],
        "properties": {
          "raw": {
            "type": "string",
            "minLength": 1
          },
          "raw_sub": {
            "type": "string"
          },
          "sport_type": {
            "type": "string",
            "minLength": 1
          },
          "sub_type": {
            "type": "string"
          },
          "modifiers": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "is_electric": {
                "type": "boolean"
              },
              "is_indoor": {
                "type": "boolean"
              },
              "is_virtual": {
                "type": "boolean"
              }
            },
            "minProperties": 1
          }
        }
      }
    }
  }
}
