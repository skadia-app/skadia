{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skadia sport gear default projection config",
  "type": "object",
  "additionalProperties": false,
  "required": ["projection_sources"],
  "properties": {
    "projection_sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
