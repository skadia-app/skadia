{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skadia sport gear default projection config",
  "type": "object",
  "additionalProperties": false,
  "required": ["projection_sources"],
  "properties": {
    "projection_sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "applicable_sport_predicates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gear_type_key", "predicates"],
        "properties": {
          "gear_type_key": { "type": "string", "minLength": 1 },
          "predicates": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["sport_type"],
              "properties": {
                "sport_type": { "type": "string", "minLength": 1 },
                "sub_type":   { "type": "string", "minLength": 1 },
                "modifiers":  { "type": "object" }
              }
            }
          }
        }
      }
    }
  }
}
