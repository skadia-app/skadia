{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skadia Sport Taxonomy Projections",
  "oneOf": [
    { "$ref": "#/$defs/activityFilterProjection" },
    { "$ref": "#/$defs/segmentProjection" },
    { "$ref": "#/$defs/ruleProjection" },
    { "$ref": "#/$defs/recordsProjection" }
  ],
  "$defs": {
    "activityFilterProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["presets"],
      "properties": {
        "presets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "labels", "groups"],
            "properties": {
              "key": { "type": "string", "minLength": 1 },
              "labels": { "$ref": "#/$defs/localeMap" },
              "groups": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["key", "entries"],
                  "oneOf": [
                    { "required": ["labels"], "not": { "required": ["label_ref"] } },
                    { "required": ["label_ref"], "not": { "required": ["labels"] } }
                  ],
                  "properties": {
                    "key": { "type": "string", "minLength": 1 },
                    "labels": { "$ref": "#/$defs/localeMap" },
                    "label_ref": { "type": "string", "pattern": "^category:[A-Za-z0-9_]+$" },
                    "entries": {
                      "type": "array",
                      "minItems": 1,
                      "items": { "$ref": "#/$defs/activityEntry" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "segmentProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domains", "segment_types", "eligible"],
      "properties": {
        "domains": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "labels", "status"],
            "properties": {
              "key": { "type": "string", "minLength": 1 },
              "labels": { "$ref": "#/$defs/localeMap" },
              "status": { "type": "string", "enum": ["active", "reserved"] }
            }
          }
        },
        "segment_types": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "labels", "active_domains", "compatibility_role"],
            "properties": {
              "key": { "type": "string", "minLength": 1 },
              "labels": { "$ref": "#/$defs/localeMap" },
              "active_domains": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              },
              "compatibility_role": {
                "type": "string",
                "enum": ["legacy_segment_type", "legacy_lift"]
              }
            }
          }
        },
        "route_options": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sport_type"],
            "properties": {
              "sport_type": { "type": "string", "minLength": 1 },
              "promoted_sub_types": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "eligible": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sport_type", "segment_types", "domains", "sport_group"],
            "properties": {
              "sport_type": { "type": "string", "minLength": 1 },
              "sub_types": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              },
              "segment_types": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              },
              "domains": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              },
              "sport_group": {
                "type": "string",
                "enum": ["bike", "foot", "swim", "ski", "paddle", "generic"]
              },
              "eligibility_role": {
                "type": "string",
                "enum": ["legacy_fallback_coverage"]
              }
            }
          }
        }
      }
    },
    "ruleProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tuple_selectors", "modifiers", "trait_conditions"],
      "properties": {
        "tuple_selectors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "labels", "source"],
            "oneOf": [
              { "required": ["field", "operators"], "not": { "required": ["action"] } },
              { "required": ["action"], "not": { "anyOf": [{ "required": ["field"] }, { "required": ["operators"] }] } }
            ],
            "properties": {
              "key": { "type": "string", "minLength": 1 },
              "labels": { "$ref": "#/$defs/localeMap" },
              "field": { "type": "string", "enum": ["sport_tuple"] },
              "operators": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "enum": ["in"] }
              },
              "action": { "type": "string", "enum": ["set_sport_type"] },
              "source": { "type": "string", "enum": ["selectable_sport_tuples"] }
            }
          }
        },
        "modifiers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "labels", "condition_applicable_from", "action_applicable_from", "render_existing"],
            "properties": {
              "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
              "labels": { "$ref": "#/$defs/localeMap" },
              "condition_applicable_from": {
                "type": "string",
                "pattern": "^modifier_applicability\\.[a-z][a-z0-9_]*$"
              },
              "action_applicable_from": {
                "type": "string",
                "pattern": "^modifier_applicability\\.[a-z][a-z0-9_]*$"
              },
              "render_existing": { "type": "boolean" }
            }
          }
        },
        "trait_conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "labels", "field", "operators", "source"],
            "properties": {
              "key": {
                "type": "string",
                "enum": ["sport_environment", "sport_equipment_family", "sport_movement_family"]
              },
              "labels": { "$ref": "#/$defs/localeMap" },
              "field": {
                "type": "string",
                "enum": ["sport_environment", "sport_equipment_family", "sport_movement_family"]
              },
              "operators": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "enum": ["in"] }
              },
              "source": {
                "type": "string",
                "enum": ["traits.environments", "traits.equipment_families", "traits.movement_families"]
              },
              "option_labels": {
                "type": "object",
                "additionalProperties": { "$ref": "#/$defs/localeMap" }
              }
            }
          }
        }
      }
    },
    "recordsProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category_sets", "category_profiles", "record_groups", "main_categories"],
      "properties": {
        "category_sets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "categories"],
            "properties": {
              "key": { "type": "string", "minLength": 1 },
              "categories": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#/$defs/recordCategory" }
              }
            }
          }
        },
        "category_profiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "category_sets"],
            "properties": {
              "key": { "type": "string", "minLength": 1 },
              "category_sets": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "record_groups": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "labels", "main_category", "color", "category_profile", "match"],
            "properties": {
              "key": { "type": "string", "minLength": 1 },
              "labels": { "$ref": "#/$defs/localeMap" },
              "main_category": { "type": "string", "minLength": 1 },
              "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
              "category_profile": { "type": "string", "minLength": 1 },
              "badge": { "type": "string" },
              "match": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#/$defs/recordMatchRule" }
              }
            }
          }
        },
        "main_categories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "labels", "color", "record_groups", "sub_filters"],
            "properties": {
              "key": { "type": "string", "minLength": 1 },
              "labels": { "$ref": "#/$defs/localeMap" },
              "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
              "record_groups": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "sub_filters": {
                "type": "array",
                "items": { "$ref": "#/$defs/recordGroupCollection" }
              },
              "power_curve": { "$ref": "#/$defs/recordGroupCollection" }
            }
          }
        }
      }
    },
    "recordCategory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "type", "labels"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "enum": ["time_lower", "value_higher", "value_superlative"] },
        "distance_m": { "type": "number" },
        "elevation_m": { "type": "number" },
        "duration_s": { "type": "integer" },
        "labels": { "$ref": "#/$defs/localeMap" }
      }
    },
    "recordMatchRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["priority", "sport_type"],
      "properties": {
        "priority": { "type": "integer" },
        "sport_type": { "type": "string", "minLength": 1 },
        "sub_types": {
          "type": "array",
          "items": { "type": "string" }
        },
        "exclude_sub_types": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "modifiers": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "is_indoor": { "type": "boolean" },
            "is_virtual": { "type": "boolean" },
            "is_electric": { "type": "boolean" }
          }
        }
      }
    },
    "recordGroupCollection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "record_groups"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "record_groups": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "localeMap": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "required": ["de"],
      "properties": {
        "de": { "type": "string", "minLength": 1 }
      }
    },
    "activityEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "category_key": { "type": "string", "minLength": 1 },
        "sport_type": { "type": "string", "minLength": 1 },
        "sub_type": { "type": "string", "minLength": 1 },
        "sport_order": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "labels": { "$ref": "#/$defs/localeMap" },
        "label_mode": {
          "type": "string",
          "enum": ["compact", "with_parent"]
        }
      },
      "oneOf": [
        { "required": ["category_key"], "not": { "required": ["sport_type"] } },
        { "required": ["sport_type"], "not": { "required": ["category_key"] } }
      ],
      "allOf": [
        {
          "if": { "required": ["sub_type"] },
          "then": { "required": ["sport_type"] }
        },
        {
          "if": { "required": ["sport_order"] },
          "then": { "required": ["category_key"] }
        }
      ]
    }
  }
}
