#!/usr/bin/env bash
# Pre-commit hook: tsc baseline gate for frontend/
#
# Blocks commits that introduce new TypeScript errors beyond the current
# baseline (frontend/.tsc-baseline). Auto-lowers the baseline when errors
# decrease. Only runs when .ts/.tsx files under frontend/ are staged.
#
# To activate in a fresh clone: ./scripts/install-git-hooks.sh

set -u

REPO_ROOT="$(git rev-parse --show-toplevel)"
BASELINE_FILE="$REPO_ROOT/frontend/.tsc-baseline"

# Scope check: only run when staged changes touch frontend TS/TSX
if ! git diff --cached --name-only --diff-filter=ACMR | grep -qE '^frontend/.*\.(ts|tsx)$'; then
    exit 0
fi

cd "$REPO_ROOT/frontend" || exit 1

if ! command -v npx >/dev/null 2>&1; then
    echo "pre-commit: npx not found, skipping tsc gate (install Node to enable)" >&2
    exit 0
fi

TSC_OUTPUT=$(npx tsc -b --pretty false 2>&1)
ERRORS=$(printf '%s\n' "$TSC_OUTPUT" | grep -c "error TS" || true)
BASELINE=$(cat "$BASELINE_FILE" 2>/dev/null || echo "0")

if [ "$ERRORS" -gt "$BASELINE" ]; then
    echo ""
    echo "pre-commit: tsc errors $ERRORS > baseline $BASELINE — commit blocked"
    echo ""
    printf '%s\n' "$TSC_OUTPUT" | grep "error TS" | head -15
    echo ""
    echo "If the increase is intentional (e.g. you accept a new error):"
    echo "  echo $ERRORS > frontend/.tsc-baseline && git add frontend/.tsc-baseline"
    echo ""
    exit 1
fi

if [ "$ERRORS" -lt "$BASELINE" ]; then
    echo "$ERRORS" > "$BASELINE_FILE"
    git add "$BASELINE_FILE"
    echo "pre-commit: tsc baseline lowered $BASELINE -> $ERRORS"
fi

exit 0
