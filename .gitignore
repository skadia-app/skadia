# Environment
.env

# Data / temp (Laufzeitdaten, nicht im Git)
# data/* statt data/ damit Unterverzeichnisse per !-Ausnahme freigebbar sind
data/*
!data/tiles/
!data/brouter/
temp/

# Tile-Dateien zu groß für Git — nur .gitkeep tracken
data/tiles/*
!data/tiles/.gitkeep

# BRouter: Segmente (rd5, binär, mehrere GB) ignorieren; Profile und Verzeichnisstruktur behalten
data/brouter/segments/*
!data/brouter/segments/.gitkeep
data/dem/

# Python
__pycache__/
*.py[cod]
*.pyo

# Go binaries
services/api/api
services/api/restore
services/api/cmd/*/main
*.exe

# IDE
.idea/
.vscode/
*.swp
*.swo
*.kate-swp

# OS
.DS_Store
Thumbs.db

# Local agent/session state
.claude/
.worktrees/
.private/
TASKS.md

















CLAUDE.md
CLAUDE.MD
frontend/CLAUDE.md
frontend/CLAUDE.MD
