# Environment
.env
.envrc
.superpowers/

# Obsidian workspace state (personal, not tracked)
.obsidian/

# Compose dev overrides (personal, not tracked)
docker-compose.override.yml

# Garage — generated from garage.toml.template (contains secrets)
garage/garage.toml

# Data / temp (runtime artefacts, not in git)
# `data/*` rather than `data/` so subdirectories can be re-included via `!` exceptions
data/*
!data/tiles/
!data/brouter/
temp/
tmp/

# Tile files too large for git — only the .gitkeep is tracked
data/tiles/*
!data/tiles/.gitkeep

# BRouter: ignore segment files (rd5, binary, multiple GB); keep profiles + directory structure
data/brouter/segments/*
!data/brouter/segments/.gitkeep
data/dem/

# Tooling caches / dependencies (catch-all for root + subtrees)
**/node_modules/
**/.vite/
**/.cache/
*.log

# Frontend npm commands must run from frontend/; ignore accidental root lockfile.
/package-lock.json

# Python
__pycache__/
*.py[cod]
*.pyo

# Go binaries
services/api/api
services/api/restore
services/api/applicablemodifiersgen
services/api/cmd/*/main
*.exe

# Go test binaries (from `go test -c` / `-coverprofile`-Runs)
*.test

# IDE
.idea/
.vscode/
*.swp
*.swo
*.kate-swp

# OS
.DS_Store
Thumbs.db

# Local agent/session state
.claude/
.worktrees/
.private/
TASKS.md

# Per-clone hook overrides (gitignored on purpose; defaults live in .githooks/pre-commit)
.githooks/config.local.sh















# Traefik dynamic config — generated by setup script (mode-specific, not tracked)
traefik/dynamic/localhost.yml
traefik/dynamic/redirect.yml





# Codex CLI trust marker (per-project)
.codex

# Go compiled cmd binaries (`go build ./cmd/<name>` from services/api/ drops the
# binary into services/api/<name>). Source lives in services/api/cmd/<name>/.
services/api/api
services/api/migrate
services/api/restore
services/api/lift_recompute_all
services/api/lift_detect_debug
services/api/lift_detect_eval
services/api/lift_detect_viz
services/api/landmark_admissibility_check

# Convention for local-only data referenced from documentation: anything
# under .private/ stays out of the repository. Recipes and examples may
# suggest this path as a default for local corpora, calibration history,
# or per-developer scratch state — adoption is opt-in.
.private/
CLAUDE.md
CLAUDE.MD
frontend/CLAUDE.md
frontend/CLAUDE.MD
