POSTGRES_PASSWORD=skadia_dev_password

# ── Secrets via File ─────────────────────────────────────────────────────────
# Listed secret env vars support a _FILE suffix (e.g. SMTP_PASSWORD_FILE=/run/secrets/smtp_password).
# When set, the value is read from the file instead of the env var. _FILE takes precedence.
# Supported: JWT_SECRET, SMTP_PASSWORD, OAUTH_ENCRYPTION_KEY, LLM_ENCRYPTION_KEY,
#            LLM_API_KEY, KOMOOT_ENCRYPTION_KEY, S3_ACCESS_KEY, S3_SECRET_KEY,
#            GARAGE_ACCESS_KEY, GARAGE_SECRET_KEY, ML_CALLBACK_SECRET,
#            ML_LLM_BROKER_TOKEN, STRAVA_CLIENT_SECRET, GOOGLE_CLIENT_SECRET

# ── Domain & TLS ─────────────────────────────────────────────────────────────
# compose-local = private/local Compose install, compose-server = domain + HTTPS,
# development = Vite frontend on :5173. setup.sh writes this explicitly.
SKADIA_DEPLOYMENT_TARGET=compose
SKADIA_DEPLOYMENT_MODE=compose-local
SKADIA_DEPLOYMENT_PROFILE=full
SKADIA_CONTAINER_RUNTIME=auto
SKADIA_DATA_ROOT=./data
# Build metadata injected by CI/release tooling. Local Compose defaults to
# "unknown" or empty when these are unset.
# SKADIA_GIT_COMMIT=unknown
# SKADIA_GIT_COMMIT_TIME=unknown
# SKADIA_BUILD_TIME=unknown
# SKADIA_IMAGE_DIGEST=
SKADIA_CONFIG_VERSION=1
# Multi-process deployment hints. Compose self-hosting normally keeps one API
# and one ML instance unless explicitly scaled.
SKADIA_REPLICA_COUNT=1
SKADIA_SHARED_STORAGE=false
# Runtime/userns/SELinux values are derived by scripts/setup.sh. Leave empty
# for Compose defaults before setup; setup.sh writes concrete local values.
SKADIA_CONTAINER_USER=
SKADIA_API_USERNS_MODE=
SKADIA_ML_USERNS_MODE=
SKADIA_VOLUME_OPTS_RW_PRIVATE=
SKADIA_VOLUME_OPTS_RW_SHARED=
SKADIA_VOLUME_OPTS_RO_PRIVATE=
SKADIA_VOLUME_OPTS_RO_SHARED=
DOCKER_SOCKET=
COMPOSE_FILE=docker-compose.yml
COMPOSE_PROFILES=full-local-data
DOMAIN=localhost
# ACME_EMAIL=admin@example.com  # Required for TLS (Let's Encrypt), not needed for localhost
TRAEFIK_ENTRYPOINT=web
TRAEFIK_TLS_ENABLED=false
TRAEFIK_CERTRESOLVER=

# ── ShadowFS ───────────────────────────────────────────────────────────────
# Storage mode is the product/install choice; STORAGE_BACKEND is the implementation backend.
SKADIA_STORAGE_MODE=local

# Storage backend: "local" (default, no extra services required) or "s3"
STORAGE_BACKEND=local

# Local backend: host path for the library (bind-mounted into /data/library)
# LIBRARY_HOST_PATH=./data/library
# SHADOW_FS_HOST_PATH=./data/shadow-fs
# HOTFOLDER_HOST_PATH=./data/hotfolder
# OSM_HOST_PATH=./data/osm
# ROUTING_HOST_PATH=./data/routing
# DEM_HOST_PATH=./data/dem
# TILES_HOST_PATH=./data/tiles
# BROUTER_SEGMENTS_HOST_PATH=./data/brouter/segments
# BROUTER_PROFILES_HOST_PATH=./data/brouter/profiles
# EXPORTS_HOST_PATH=./data/exports
# IMPORTS_HOST_PATH=./data/imports

# GDPR transfer artifacts (short-lived export/import files)
# auto follows STORAGE_BACKEND. Use s3 for multi-pod deployments unless all API pods share the same persistent volume.
GDPR_ARTIFACT_BACKEND=auto
EXPORTS_BASE_PATH=/data/exports
IMPORTS_BASE_PATH=/data/imports

# Storage options:
# LIBRARY_KEEP_VERSIONS=1             # 0=delete, 1=keep last version, -1=keep all
# MAX_USER_STORAGE_BYTES=53687091200  # 50 GB default per user (0=unlimited)
# LIBRARY_SYNC_ENABLED=false          # true=watch library dir for new files (hotfolder)
# LIBRARY_SYNC_AUTO_IMPORT=false      # true=auto-import detected files

# S3 backend (set SKADIA_STORAGE_MODE=s3-local-garage or s3-external; local Garage also needs COMPOSE_PROFILES=full-local-data,s3)
# SKADIA_S3_PROVIDER=local-garage  # compatibility hint: local-garage | external; setup.sh writes this when S3 is selected
# GARAGE_ENDPOINT=http://garage:3900
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_ACCESS_KEY_FILE=
# S3_SECRET_KEY=
# S3_SECRET_KEY_FILE=
# S3_BUCKET=skadia-originals
# S3_BUCKET_EXPORTS=skadia-exports
# S3_BUCKET_IMPORTS=skadia-imports
# S3_EXPORTS_PREFIX=gdpr/exports
# S3_IMPORTS_PREFIX=gdpr/imports
# S3_REGION=us-east-1
# S3_FORCE_PATH_STYLE=
# S3_BUCKET_ACTIVITY=skadia-originals
# S3_BUCKET_MEDIA=skadia-media

# GDPR multipart export/import limits
# GDPR_EXPORT_MULTIPART_THRESHOLD_BYTES=2147483648
# GDPR_EXPORT_PART_TARGET_BYTES=2147483648
# GDPR_EXPORT_PART_WARN_BYTES=4294967296
# GDPR_MULTIPART_MAX_PARTS=256

# DEPRECATED: use S3_* vars above when STORAGE_BACKEND=s3
# These are kept for backward compatibility — values are auto-mapped to S3_* if set.
GARAGE_ACCESS_KEY=
# GARAGE_ACCESS_KEY_FILE=
GARAGE_SECRET_KEY=
# GARAGE_SECRET_KEY_FILE=
# 64 hex chars — auto-generated by setup.sh if empty
GARAGE_RPC_SECRET=
# 64 hex chars — auto-generated by setup.sh if empty, required for Garage admin API
GARAGE_ADMIN_TOKEN=

# Auth (Go-native)
# REQUIRED: 64 hex chars (32 bytes). Generate: openssl rand -hex 32 — auto-generated by setup.sh if empty
JWT_SECRET=
# JWT_SECRET_FILE=
# invite | open | approval
# Can be configured at runtime via Admin UI. Env var overrides UI setting when set.
REGISTRATION_MODE=invite
# Required if social login enabled. Generate: openssl rand -hex 32 — auto-generated by setup.sh if empty
OAUTH_ENCRYPTION_KEY=
# OAUTH_ENCRYPTION_KEY_FILE=

# Social Login (optional)
# Can be configured at runtime via Admin UI. Env var overrides UI setting when set.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# STRAVA_CLIENT_SECRET_FILE=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_CLIENT_SECRET_FILE=

# SMTP (optional, required for open registration)
# Can be configured at runtime via Admin UI. Env var overrides UI setting when set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# SMTP_PASSWORD_FILE=/run/secrets/smtp_password  # Alternative: read password from file (takes precedence)
SMTP_FROM=
SMTP_TLS=starttls  # starttls (default) | ssl | none

# Settings encryption (for Admin UI stored secrets — SMTP password, OAuth secrets)
# Generate: openssl rand -hex 32 — auto-generated by setup.sh if empty
# Can fall back to OAUTH_ENCRYPTION_KEY if not set.
SETTINGS_ENCRYPTION_KEY=
# SETTINGS_ENCRYPTION_KEY_FILE=

# Hotfolder mode: disabled (default) | admin-only | self-service
# Can be configured at runtime via Admin UI. Env var overrides UI setting.
# HOTFOLDER_MODE=disabled

# Bootstrap admin (optional, consumed on first start when no users exist)
# BOOTSTRAP_ADMIN_USER=
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_PASSWORD_FILE=
# SECURITY: Remove BOOTSTRAP_ADMIN_PASSWORD after first start

# App
# Can be configured at runtime via Admin UI. Env var overrides UI setting when set.
APP_NAME=Skadia
APP_URL=http://localhost:8080
# Host port for the combined API and web app in Compose mode.
SKADIA_APP_PORT=8080
TRUSTED_PROXY_CIDRS=   # e.g. 10.89.0.0/16,172.16.0.0/12
MOBILE_REDIRECT_URI=   # e.g. skadia://auth
FRONTEND_URL=http://localhost:8080
# Static frontend directory inside the API container image.
FRONTEND_STATIC_DIR=/app/frontend

# ── Logging ──────────────────────────────────────────────────────────────────
# LOG_LEVEL=info  # debug, info, warn, error
# Optional internal Prometheus scrape listener. Keep empty to disable.
# Self-host host scrape example: 127.0.0.1:9090 plus an explicit localhost port mapping.
# Container/Kubernetes scrape example: :9090 restricted by service/network policy.
# SKADIA_METRICS_ADDR=

# Start the API directly outside Compose.
DATABASE_URL=postgres://skadia:skadia_dev_password@localhost:5432/skadia?sslmode=disable

# ── PostgreSQL runtime tuning ────────────────────────────────────────────────
# Defaults match docker-compose.yml. setup.sh writes the storage-sensitive values.
# Keep shared_buffers/checkpoint settings bounded on btrfs; see ADR-0024.
# POSTGRES_MEM_LIMIT=8g
# POSTGRES_SHM_SIZE=1gb
# POSTGRES_MAX_CONNECTIONS=200
# POSTGRES_SHARED_BUFFERS=4GB
# POSTGRES_WORK_MEM=64MB
# POSTGRES_MAINTENANCE_WORK_MEM=512MB
# POSTGRES_MAX_PARALLEL_WORKERS_PER_GATHER=4
# POSTGRES_RANDOM_PAGE_COST=1.1
# POSTGRES_EFFECTIVE_IO_CONCURRENCY=200
# POSTGRES_EFFECTIVE_CACHE_SIZE=4GB
# POSTGRES_CHECKPOINT_TIMEOUT=60s
# POSTGRES_MAX_WAL_SIZE=512MB
# POSTGRES_ARCHIVE_MODE=off
# POSTGRES_WAL_LEVEL=minimal
# POSTGRES_MAX_WAL_SENDERS=0

# Test database for local Go tests.
# Do not hardcode TEST_DATABASE_URL here for multi-worktree development. Use:
#   ./scripts/test_db.sh ensure
#   eval "$(./scripts/test_db.sh emit-url)"
# or copy .envrc.example to .envrc. That workflow assigns each worktree its own
# skadia_test_<slug> database and avoids shared-schema state.
# TEST_DATABASE_URL=postgres://skadia:skadia_dev_password@localhost:5432/skadia_test_<slug>?sslmode=disable

# Development without auth (fixed dev user, not for production). setup.sh never enables this automatically.
# For Vite development use SKADIA_DEPLOYMENT_MODE=development plus frontend VITE_* env vars.
# DEV_AUTH=true

# Optional fallback endpoint/key for legacy callers. Configured Skadia LLM roles
# use their direct provider api_base from the admin settings UI/API; LiteLLM is
# optional and should remain internal-only when enabled.
LLM_BASE_URL=http://litellm:4000/v1
LLM_API_KEY=
# LLM_API_KEY_FILE=/run/secrets/llm_api_key
LLM_CONTEXT_WINDOW=8000
ML_CALLBACK_SECRET=
# ML_CALLBACK_SECRET_FILE=/run/secrets/ml_callback_secret
# ML_LLM_BROKER_TOKEN_FILE=/run/secrets/ml_llm_broker_token

# Read-only SQL role used by the Go SQL agent and ML read paths.
# setup.sh generates READONLY_PASSWORD and the API syncs the database role at startup.
# READONLY_PASSWORD does not support _FILE because Compose interpolates it into READONLY_DATABASE_URL.
READONLY_PASSWORD=skadia_readonly_password
# For direct local runs, set READONLY_DATABASE_URL with the generated READONLY_PASSWORD value.
# ML image build arguments.
ML_TORCH_PACKAGE=torch==2.10.0+cpu
ML_TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu

# Encryption key for external service credentials (Komoot, LLM API keys)
# Generate: openssl rand -hex 32 — auto-generated by setup.sh if empty
KOMOOT_ENCRYPTION_KEY=
# KOMOOT_ENCRYPTION_KEY_FILE=
# Generate: openssl rand -hex 32 — auto-generated by setup.sh if empty
LLM_ENCRYPTION_KEY=
# LLM_ENCRYPTION_KEY_FILE=

# ── Data Directories (defaults work for standard Podman Compose setup) ────────
# OSM_DATA_DIR=/data/osm
# DEM_DATA_DIR=/data/dem
# BROUTER_SEGMENTS_DIR=/data/brouter/segments
# BROUTER_PROFILES_DIR=/data/brouter/profiles
# TILES_DIR=/data/tiles
# ROUTING_DIR=/data/routing
# ROUTING_GRAPH_PATH=
# BADROUTER_CONFIG_HOST_PATH=./config/badrouter
# OLLAMA_HOST_PATH=./data/ollama
# MODELS_HOST_PATH=./data/models
# ML_HOST_PATH=./data/ml
# SHADOW_FS_HOST_PATH=./data/shadow-fs
# HOTFOLDER_HOST_PATH=./data/hotfolder
# IMPORT_DATA_HOST_PATH=./data/import

# ── Advanced runtime overrides ───────────────────────────────────────────────
# DOCKER_SOCKET=/run/podman/podman.sock
# BADROUTER_PROFILE_DIR=config/badrouter
# LANDMARK_STRATEGY=
# ROUTING_BIDIRECTIONAL=false
# ROUTING_VALLE_SEG=false
# HOTFOLDER_ENABLED=false  # Deprecated. Prefer HOTFOLDER_MODE.

# ── Compose Profiles (comma-separated) ───────────────────────────────────────
# COMPOSE_PROFILES=full-local-data,ml,llm    # Options: full-local-data, s3, ml, llm

# ── Library Settings Cache ────────────────────────────────────────────────────
# Library-Settings-Cache TTL (default 30 seconds).
# Set higher for low-traffic deployments, lower for Multi-Replica + frequent admin edits.
# LIBRARY_SETTINGS_TTL_SECONDS=30
