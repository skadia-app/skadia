        "properties": {
          "activity_id": { "type": "string", "pattern": "^[0-9a-fA-F-]{36}$" },
          "fields": {
            "type": "object",
            "required": ["title"],
            "additionalProperties": false,
            "properties": {
              "title": { "type": "string", "minLength": 1 }
            }
          }
        }
      },
      "must_not_contain": ["confirmed token", "executed"]
    }
  },
