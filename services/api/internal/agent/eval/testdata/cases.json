[
  {
    "id": "sql_aggregate_select",
    "name": "SQL readonly aggregate SELECT with tenant guard",
    "category": "sql_readonly",
    "roles": ["tool_agent"],
    "required_capabilities": ["sql_readonly"],
    "prompt": "Count my activities by sport using read-only SQL. Do not add user_id predicates; the runtime applies tenant isolation.",
    "expectations": {
      "must_contain": ["select", "count", "activities"],
      "must_not_contain": ["update", "delete", "insert", "; drop", "$1", "current_setting", "user_id"],
      "min_content_chars": 40
    }
  },
  {
