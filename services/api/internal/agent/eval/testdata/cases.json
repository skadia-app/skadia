  {
    "id": "tool_single_call",
    "name": "Tool call emits required tool with valid search args",
    "category": "tool_call",
    "roles": ["tool_agent"],
    "required_capabilities": ["tool_calls", "json_args"],
    "prompt": "Use query_activities for my last rides with title_search \"last rides\" and limit 5.",
    "expectations": {
      "require_tool_call": "query_activities",
      "tool_args_schema": {
        "type": "object",
        "required": ["title_search", "limit"],
        "additionalProperties": false,
        "properties": {
          "title_search": { "type": "string", "minLength": 3 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 20 }
        }
      },
      "must_not_contain": ["cannot call tools"]
    }
  },
  {
    "id": "tool_required_named_call",
    "name": "Tool call honors named tool and UUID argument",
    "category": "tool_call",
    "roles": ["tool_agent"],
    "required_capabilities": ["tool_calls", "json_args"],
    "prompt": "Call get_activity_detail with activity_id 11111111-1111-4111-8111-111111111111.",
    "expectations": {
      "require_tool_call": "get_activity_detail",
      "tool_args_schema": {
        "type": "object",
        "required": ["activity_id"],
        "additionalProperties": false,
        "properties": {
          "activity_id": { "type": "string", "pattern": "^[0-9a-fA-F-]{36}$" }
        }
      }
    }
  },
  {
    "id": "tool_invalid_args_repair",
    "name": "Tool call repairs invalid arguments",
    "category": "tool_call",
