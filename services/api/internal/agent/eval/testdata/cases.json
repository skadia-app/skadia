        "type": "object",
        "required": ["title_search", "limit"],
        "additionalProperties": false,
        "properties": {
          "title_search": { "type": "string", "minLength": 3 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 20 }
        }
      },
      "must_not_contain": ["text-only fallback"]
    }
  },
  {
    "id": "document_invoice_json_extract",
    "name": "Document extraction returns structured JSON",
    "category": "document_extract",
    "roles": ["document_extract"],
    "required_capabilities": ["document_extract", "json_extract"],
    "prompt": "Extract invoice_date, vendor, total_amount and currency from this OCR text as JSON only: Rechnung ACME Testlabor, Datum 2026-05-01, Summe 42,50 EUR.",
    "expectations": {
      "must_contain": ["invoice_date", "vendor", "total_amount", "currency"],
      "must_not_contain": ["```", "here is"],
      "require_json_output": true
    }
  },
  {
    "id": "markdown_table_no_loop",
    "name": "Markdown table preservation and hard stop",
    "category": "markdown_no_loop",
    "roles": ["markdown_extract"],
    "required_capabilities": ["markdown_extract", "table_preservation"],
    "prompt": "Convert this table to raw Markdown and stop: Name | Wert; CTL | 71; ATL | 63.",
    "expectations": {
      "must_contain": ["|"],
      "must_not_contain": ["here is", "continued", "weiter"],
      "finish_reason": "stop",
      "min_content_chars": 12
    }
  },
  {
    "id": "vision_observation_json",
    "name": "Vision role extracts visible evidence only",
    "category": "vision",
    "roles": ["vision"],
    "required_capabilities": ["vision"],
    "prompt": "For the supplied image, return JSON with visible_objects and uncertainty. Do not infer unreadable text.",
    "image_data_url": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+/p9sAAAAASUVORK5CYII=",
    "expectations": {
      "must_contain": ["visible_objects", "uncertainty"],
      "must_not_contain": ["probably says", "invented"],
      "require_json_output": true
    }
  },
  {
    "id": "write_preview_decline",
    "name": "Write preview respects decline",
    "category": "write_preview",
    "roles": ["tool_agent"],
    "required_capabilities": ["write_preview"],
    "prompt": "Prepare an update_activity_metadata title edit for activity 11111111-1111-4111-8111-111111111111, show preview, then respect user decline.",
    "expectations": {
