#!/usr/bin/env bash
#
# Git pre-commit helper: block new public-facing text that exposes private
# coordinates, host paths, sensitive filenames, or locally configured private
# names. Tests and source code may still use synthetic coordinates where needed.

set -uo pipefail

if [ -z "${BASH_VERSION:-}" ]; then
    echo "public-content-guard: Bash required." >&2
    exit 2
fi

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
DIFF_FILE=""
while [ $# -gt 0 ]; do
    case "$1" in
        --diff-file)
            DIFF_FILE="${2:-}"
            shift 2
            ;;
        *)
            echo "public-content-guard: unknown argument: $1" >&2
            exit 2
            ;;
    esac
done

PRIVATE_PATTERNS_FILE="${SKADIA_PUBLIC_CONTENT_PRIVATE_PATTERNS:-$REPO_ROOT/.githooks/private-patterns.local.re}"

LOCAL_PRIVATE_RE='(/home/[[:alnum:]_.-]+|/var/home/[[:alnum:]_.-]+|/Users/[[:alnum:]_.-]+|[A-Za-z]:\\Users\\)'
COORDINATE_RE='(^|[^0-9])[-+]?[0-9]{1,2}\.[0-9]{4,}[[:space:]]*[^0-9,;[:space:]]?[[:space:]]*[NS]?[,;[:space:]]+(lon(gitude)?[[:space:]]*=[[:space:]]*)?[-+]?[0-9]{1,3}\.[0-9]{4,}[[:space:]]*[^0-9[:space:]]?[[:space:]]*[EW]?([^0-9]|$)|lat(itude)?[[:space:]]*=[[:space:]]*[-+]?[0-9]{1,2}\.[0-9]{4,}[^0-9]+lon(gitude)?[[:space:]]*=[[:space:]]*[-+]?[0-9]{1,3}\.[0-9]{4,}'
SENSITIVE_FILENAME_TOKEN_RE='(^|[^[:alnum:]_.-])([[:alnum:]_.-]+\.(fit|gpx|tcx|kml|kmz|zip|tar|tgz|7z|xlsx|xls|docx|pdf|png|jpe?g|heic|avif))([^[:alnum:]_-]|$)'
SYNTHETIC_FILENAME_TOKEN_RE='^(synthetic|example|sample)-[[:alnum:]_.-]+\.(fit|gpx|tcx|kml|kmz|zip|tar|tgz|7z|xlsx|xls|docx|pdf|png|jpe?g|heic|avif)$'
INTERNAL_PUBLIC_PATH_RE='(^|[^[:alnum:]_.-])(\.?docs/(plans|research|_internal|archive|superpowers|reviews)(/[^[:space:]]*)?|\.private(/[^[:space:]]*)?|\.superpowers(/[^[:space:]]*)?|\.claude(/[^[:space:]]*)?|memory/[^[:space:]]*|ideas/[^[:space:]]*)($|[^[:alnum:]_.-])'
PUBLIC_WORKFLOW_RE='(^|[^[:alnum:]_])(phase[[:space:]_-]*[0-9]+|task[[:space:]_-]*[0-9]+|(plan|spec)[[:space:]_-]+[A-Za-z0-9][A-Za-z0-9_-]*|critic|kritiker|findings?|fixed[[:space:]_-]+review[[:space:]_-]+findings|fixed[[:space:]_-]+critic[[:space:]_-]+findings)([^[:alnum:]_]|$)'
THIRD_PARTY_FRAMING_RE='(^|[^[:alnum:]_])(inspired[[:space:]]+by|direct[[:space:]]+inspiration|per[[:space:]]+[[:alnum:]_. /+-]{2,80}[[:space:]]+standard)([^[:alnum:]_]|$)'
AGENT_MODEL_RE='(^|[^[:alnum:]_])(claude|codex|gemini|opus|sonnet|haiku|gpt([[:space:]-]*[0-9][A-Za-z0-9_.-]*)?|openai|anthropic)([^[:alnum:]_]|$)'
PRIVATE_TAG_RE='(^|[^[:alnum:]_])#[[:alpha:]_][[:alnum:]_-]*|(^|[[:space:]])tags?:[[:space:]]*[^[:space:]]+'

PUBLIC_WORDING_TEXT_PATH_RE='(^CHANGELOG\.md$|^README\.md$|^CONTRIBUTING\.md$|^SECURITY\.md$|^docs/documentation/.*\.(md|mdx)$)'
PUBLIC_DOC_TEXT_PATH_RE='^docs/.*\.(md|mdx)$'
PUBLIC_PRIVACY_TEXT_PATH_RE='(^CHANGELOG\.md$|^README\.md$|^CONTRIBUTING\.md$|^SECURITY\.md$|(^|.*/)(AGENTS|CLAUDE|GEMINI)\.md$|^docs/documentation/.*\.(md|mdx)$)'
INTERNAL_DOC_TEXT_PATH_RE='^docs/(plans|research|_internal|archive|superpowers|reviews)/.*\.(md|mdx|txt)$'
GUARD_FIXTURE_PATH_RE='^(\.githooks/(commit-msg|public-content-guard)|scripts/(commit_msg_guard_internal|public_content_guard_internal)/test\.sh)$'
TEST_OR_FIXTURE_PATH_RE='(^|/)(testdata|fixtures?)/|_test\.(go|ts|tsx|js|jsx)$|(\.spec|\.test)\.(ts|tsx|js|jsx)$'

is_internal_doc_text_path() {
    local path="$1"
    printf '%s\n' "$path" | grep -Eq "$INTERNAL_DOC_TEXT_PATH_RE"
}

is_public_wording_text_path() {
    local path="$1"
    if printf '%s\n' "$path" | grep -Eq "$PUBLIC_WORDING_TEXT_PATH_RE"; then
        return 0
    fi
    if printf '%s\n' "$path" | grep -Eq "$PUBLIC_DOC_TEXT_PATH_RE" \
        && ! is_internal_doc_text_path "$path"; then
        return 0
    fi
    return 1
}

is_privacy_text_path() {
    local path="$1"
    printf '%s\n' "$path" | grep -Eq "$PUBLIC_PRIVACY_TEXT_PATH_RE|$PUBLIC_DOC_TEXT_PATH_RE|$INTERNAL_DOC_TEXT_PATH_RE"
}

is_guard_fixture_path() {
    local path="$1"
    printf '%s\n' "$path" | grep -Eq "$GUARD_FIXTURE_PATH_RE"
}

is_test_or_fixture_path() {
    local path="$1"
    printf '%s\n' "$path" | grep -Eq "$TEST_OR_FIXTURE_PATH_RE"
}

is_allowed_public_doc_provenance_metadata() {
    local path="$1"
    local text="$2"

    printf '%s\n' "$path" | grep -Eq '^docs/documentation/.*\.(md|mdx)$' || return 1
    printf '%s\n' "$text" | grep -Eq '^\*(Created|Last updated):[[:space:]]+[0-9]{4}-[0-9]{2}-[0-9]{2}([[:space:]]+\([A-Za-z0-9_. -]+\))?\*$'
}

has_blocking_sensitive_filename() {
    local text="$1"
    local token
    local saw=false

    case "$text" in
        *.*) ;;
        *) return 1 ;;
    esac
    if ! printf '%s\n' "$text" | grep -Eiq '\.(fit|gpx|tcx|kml|kmz|zip|tar|tgz|7z|xlsx|xls|docx|pdf|png|jpe?g|heic|avif)([^[:alnum:]_-]|$)'; then
        return 1
    fi

    while IFS= read -r token; do
        [ -n "$token" ] || continue
        token=$(printf '%s\n' "$token" | sed -E 's/^[^[:alnum:]_.-]+//; s/[^[:alnum:]_-]+$//')
        [ -n "$token" ] || continue
        saw=true
        if ! printf '%s\n' "$token" | grep -Eiq "$SYNTHETIC_FILENAME_TOKEN_RE"; then
            return 0
        fi
    done < <(printf '%s\n' "$text" | grep -Eoi "$SENSITIVE_FILENAME_TOKEN_RE")

    [ "$saw" = true ] || return 1
    return 1
}

validate_private_patterns_file() {
    local file="$1"
    local pattern
    local status

    [ -f "$file" ] || return 0
    if [ ! -r "$file" ]; then
        echo "public-content-guard: private pattern file is not readable: $file" >&2
        exit 2
    fi

    while IFS= read -r pattern; do
        [ -z "$pattern" ] && continue
        printf 'x\n' | grep -Eq "$pattern" >/dev/null 2>&1
        status=$?
        if [ "$status" -eq 2 ]; then
            echo "public-content-guard: invalid regex in $file: $pattern" >&2
            exit 2
        fi
    done < <(awk 'NF && $0 !~ /^[[:space:]]*#/ {print}' "$file")
}

WARNINGS=()
current_path=""
current_is_guard_fixture=false
current_is_test_or_fixture=false
current_is_privacy_text=false
current_is_public_wording_text=false

validate_private_patterns_file "$PRIVATE_PATTERNS_FILE"

scan_line() {
    local path="$1"
    local line_no="$2"
    local text="$3"
    local local_private_text

    if [ "$current_is_guard_fixture" != true ]; then
        case "$text" in
            *"/var/home/"*|*"/home/"*|*"/Users/"*|*"\\Users\\"*)
                local_private_text="$(printf '%s\n' "$text" | sed -E 's#/home/postgres(/|$)# #g')"
                if printf '%s\n' "$local_private_text" | grep -Eq "$LOCAL_PRIVATE_RE"; then
                    WARNINGS+=("local/private detail in ${path}:${line_no}: ${text}")
                fi
                ;;
        esac

        if [ -f "$PRIVATE_PATTERNS_FILE" ]; then
            if printf '%s\n' "$text" | grep -Eq -f <(awk 'NF && $0 !~ /^[[:space:]]*#/ {print}' "$PRIVATE_PATTERNS_FILE"); then
                WARNINGS+=("local private pattern in ${path}:${line_no}: ${text}")
            fi
        fi
    fi

    if [ "$current_is_guard_fixture" != true ] && [ "$current_is_test_or_fixture" != true ]; then
        case "$text" in
            *.*,*|*"lat"*|*"lon"*|*"Lat"*|*"Lon"*|*"LAT"*|*"LON"*)
                if printf '%s\n' "$text" | grep -Ei "$COORDINATE_RE" >/dev/null; then
                    WARNINGS+=("coordinate in public/private text ${path}:${line_no}: ${text}")
                fi
                ;;
        esac
        if has_blocking_sensitive_filename "$text"; then
            WARNINGS+=("sensitive filename in public/private text ${path}:${line_no}: ${text}")
        fi
    fi

    if [ "$current_is_privacy_text" = true ] && [ "$current_is_public_wording_text" != true ]; then
        case "$text" in
            *"#"*|*"tag:"*|*"tags:"*|*"Tag:"*|*"Tags:"*)
                if printf '%s\n' "$text" | grep -Ei "$PRIVATE_TAG_RE" >/dev/null; then
                    WARNINGS+=("private tag marker in public/private text ${path}:${line_no}: ${text}")
                fi
                ;;
        esac
    fi

    if [ "$current_is_public_wording_text" = true ]; then
        if printf '%s\n' "$text" | grep -Ei "$INTERNAL_PUBLIC_PATH_RE" >/dev/null; then
            WARNINGS+=("internal path in public text ${path}:${line_no}: ${text}")
        fi
        if printf '%s\n' "$text" | grep -Ei "$PUBLIC_WORKFLOW_RE" >/dev/null; then
            WARNINGS+=("internal workflow wording in public text ${path}:${line_no}: ${text}")
        fi
        if printf '%s\n' "$text" | grep -Ei "$THIRD_PARTY_FRAMING_RE" >/dev/null; then
            WARNINGS+=("third-party platform framing in public text ${path}:${line_no}: ${text}")
        fi
        if ! is_allowed_public_doc_provenance_metadata "$path" "$text" \
            && printf '%s\n' "$text" | grep -Ei "$AGENT_MODEL_RE" >/dev/null; then
            WARNINGS+=("agent/model name in public text ${path}:${line_no}: ${text}")
        fi
        if printf '%s\n' "$text" | grep -Ei "$PRIVATE_TAG_RE" >/dev/null; then
            WARNINGS+=("private tag marker in public text ${path}:${line_no}: ${text}")
        fi
    fi
}

line_no=0
while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
        "+++ b/"*)
            current_path="${line#+++ b/}"
            current_is_guard_fixture=false
            current_is_test_or_fixture=false
            current_is_privacy_text=false
            current_is_public_wording_text=false
            if is_guard_fixture_path "$current_path"; then
                current_is_guard_fixture=true
            fi
            if is_test_or_fixture_path "$current_path"; then
                current_is_test_or_fixture=true
            fi
            if is_privacy_text_path "$current_path"; then
                current_is_privacy_text=true
            fi
            if is_public_wording_text_path "$current_path"; then
                current_is_public_wording_text=true
            fi
            line_no=0
            continue
            ;;
        "+++ /dev/null")
            current_path=""
            current_is_guard_fixture=false
            current_is_test_or_fixture=false
            current_is_privacy_text=false
            current_is_public_wording_text=false
            line_no=0
            continue
            ;;
        "@@ "*)
            new_start="$(printf '%s\n' "$line" | sed -nE 's/^@@ -[0-9]+(,[0-9]+)? \+([0-9]+)(,[0-9]+)? @@.*/\2/p')"
            if [ -n "$new_start" ]; then
                line_no=$((new_start - 1))
            fi
            continue
            ;;
    esac

    [ -n "$current_path" ] || continue
    case "$line" in
        "+"*)
            case "$line" in "+++"*) continue ;; esac
            line_no=$((line_no + 1))
            scan_line "$current_path" "$line_no" "${line#+}"
            ;;
        "-"*) ;;
        *)
            line_no=$((line_no + 1))
            ;;
    esac
done < "${DIFF_FILE:-/dev/stdin}"

if [ ${#WARNINGS[@]} -eq 0 ]; then
    exit 0
fi

echo "" >&2
echo "public-content-guard: ${#WARNINGS[@]} public/private-surface item(s)" >&2
echo "" >&2
for warning in "${WARNINGS[@]}"; do
    echo "  - $warning" >&2
done
echo "" >&2
echo "Use synthetic examples in public docs and changelog entries. Tests may keep synthetic or explicitly public coordinate fixtures." >&2
echo "Keep internal planning wording out of new public docs/changelog text; internal docs are scanned for privacy leaks only." >&2
echo "Concrete private names belong in the local gitignored pattern file: .githooks/private-patterns.local.re" >&2
echo "" >&2

exit 1
